{
  "name": "llm-cost-audit",
  "version": "2.1.0",
  "description": "把 LLM 账单跑成一张可复核的浪费清单 —— 18 项判据，出金额，出证据等级，并明确告诉你哪些不建议做。",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "lapisli",
    "url": "https://github.com/lapisli"
  },
  "keywords": [
    "llm",
    "cost",
    "finops",
    "token",
    "audit",
    "ai",
    "agent-skill",
    "claude-skill",
    "prompt-caching",
    "model-routing",
    "cost-audit",
    "llm-cost"
  ],
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "llm-cost-audit": "scripts/estimate.mjs",
    "llm-cost-estimate": "scripts/estimate.mjs",
    "llm-cost-ingest": "scripts/ingest.mjs",
    "llm-cost-compare": "scripts/compare.mjs"
  },
  "exports": {
    ".": "./lib/estimate.mjs",
    "./matrix": "./lib/matrix.mjs",
    "./prices": "./lib/prices.mjs",
    "./compare": "./lib/compare.mjs"
  },
  "files": [
    "SKILL.md",
    "README.md",
    "LICENSE",
    "lib/",
    "scripts/",
    "reference/",
    "templates/",
    "examples/",
    "prices.example.json"
  ],
  "scripts": {
    "test": "node --test tests/estimate.test.mjs tests/ingest.test.mjs tests/render-html.test.mjs tests/prices.test.mjs tests/compare.test.mjs",
    "selftest": "node scripts/selftest.mjs",
    "verify": "node scripts/verify.mjs",
    "demo": "node scripts/estimate.mjs examples/sample-bill.json",
    "list": "node scripts/estimate.mjs --list",
    "prepublishOnly": "npm test && node scripts/verify.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lapisli/llm-cost-audit.git"
  },
  "bugs": {
    "url": "https://github.com/lapisli/llm-cost-audit/issues"
  },
  "homepage": "https://github.com/lapisli/llm-cost-audit#readme",
  "main": "./lib/estimate.mjs"
}
